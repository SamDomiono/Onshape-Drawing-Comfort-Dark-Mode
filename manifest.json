{
  "manifest_version": 3,
  "name": "Onshape Drawing Comfort POC",
  "version": "0.1.1",
  "minimum_chrome_version": "111",
  "description": "Experimental per-editor drawing palette bootstrap.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Drawing comfort preset",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.onshape.com/*"],
      "include_globs": ["https://production-drawing-*.onshape.com/editor*"],
      "all_frames": true,
      "world": "ISOLATED",
      "run_at": "document_idle",
      "js": ["bridge.js"]
    },
    {
      "matches": ["https://*.onshape.com/*"],
      "include_globs": ["https://production-drawing-*.onshape.com/editor*"],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_idle",
      "js": ["theme.js"]
    }
  ]
}
